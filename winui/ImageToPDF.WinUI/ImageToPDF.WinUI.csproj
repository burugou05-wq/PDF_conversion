<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>ImageToPDF.WinUI</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\app_icon.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>false</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- Release version is supplied by build_winui.ps1 from app_config.py. -->
    <Version Condition="'$(Version)' == ''">2.1.0</Version>
    <!-- Official release: one self-contained EXE. The Python worker is embedded as a resource. -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250205002" />
  </ItemGroup>

  <!-- Embed the PyInstaller worker when build_winui.ps1 has produced it. Development runs fall back to conversion_worker.py. -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\dist\ImageToPDFWorker.exe')">
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)..\..\dist\ImageToPDFWorker.exe" LogicalName="ImageToPDFWorker.exe" />
  </ItemGroup>

  <!-- Unpackaged WinUI publishes currently omit the app's generated PRI file. -->
  <Target
    Name="IncludeWinUIProjectPriInPublish"
    BeforeTargets="ComputeResolvedFilesToPublishList"
    DependsOnTargets="$(GenerateProjectPriFile)"
    Condition="'$(WindowsPackageType)' == 'None' and '$(UseWinUI)' == 'true'">
    <Error
      Condition="'$(ProjectPriFullPath)' == '' or !Exists('$(ProjectPriFullPath)')"
      Text="The generated WinUI project PRI is missing: $(ProjectPriFullPath)" />
    <ItemGroup>
      <ResolvedFileToPublish Include="$(ProjectPriFullPath)">
        <RelativePath>$(ProjectPriFileName)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <!-- Compiled XAML binaries must be part of the single-file bundle, not loose files beside the EXE. -->
  <Target
    Name="IncludeWinUIXamlBinariesInPublish"
    AfterTargets="ComputeResolvedFilesToPublishList"
    Condition="'$(WindowsPackageType)' == 'None' and '$(UseWinUI)' == 'true'">
    <ItemGroup>
      <_WinUIXamlBinary Include="$(OutputPath)**\*.xbf" />
      <ResolvedFileToPublish Include="@(_WinUIXamlBinary)">
        <RelativePath>%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
