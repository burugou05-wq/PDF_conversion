<?xml version='1.0' encoding='utf-8'?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:models="using:ImageToPDF.WinUI.Models" x:Class="ImageToPDF.WinUI.MainWindow" Title="画像PDF変換ツール" mc:Ignorable="d">
  <Border x:Name="Root" Padding="24,18" AllowDrop="True" DragOver="Root_DragOver" Drop="Root_Drop" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" SizeChanged="Root_SizeChanged">
    <Border.Resources>
      <!-- リスト表示とグリッド表示は、同じListViewの ItemsPanel と ItemTemplate を差し替えます。 -->
      <ItemsPanelTemplate x:Key="ListPanel">
        <ItemsStackPanel Orientation="Vertical"/>
      </ItemsPanelTemplate>
      <ItemsPanelTemplate x:Key="GridPanel">
        <ItemsWrapGrid Orientation="Horizontal"/>
      </ItemsPanelTemplate>
      <!-- 行とタイルで共通の右クリックメニュー。Tag に ImageEntry が入ります。 -->
      <MenuFlyout x:Key="ItemMenu">
        <MenuFlyoutItem Text="エクスプローラーで表示" Click="ShowInExplorer_Click">
          <MenuFlyoutItem.Icon>
            <FontIcon Glyph=""/>
          </MenuFlyoutItem.Icon>
        </MenuFlyoutItem>
        <MenuFlyoutItem Text="パスをコピー" Click="CopyPath_Click">
          <MenuFlyoutItem.Icon>
            <FontIcon Glyph=""/>
          </MenuFlyoutItem.Icon>
        </MenuFlyoutItem>
        <MenuFlyoutItem Text="サムネイルを再読み込み" Click="ReloadThumbnail_Click">
          <MenuFlyoutItem.Icon>
            <FontIcon Glyph=""/>
          </MenuFlyoutItem.Icon>
        </MenuFlyoutItem>
        <MenuFlyoutSeparator/>
        <MenuFlyoutItem Text="これより上を削除" Click="RemoveAbove_Click"/>
        <MenuFlyoutItem Text="これより下を削除" Click="RemoveBelow_Click"/>
        <MenuFlyoutItem Text="選択を削除" Click="RemoveButton_Click">
          <MenuFlyoutItem.Icon>
            <FontIcon Glyph=""/>
          </MenuFlyoutItem.Icon>
        </MenuFlyoutItem>
      </MenuFlyout>
      <DataTemplate x:Key="RowTemplate" x:DataType="models:ImageEntry">
        <Border Padding="10,8" ContextFlyout="{StaticResource ItemMenu}" RightTapped="Item_RightTapped">
          <Grid ColumnDefinitions="32,*,Auto" ColumnSpacing="12">
            <FontIcon Glyph="{x:Bind IconGlyph}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
              <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="{x:Bind ParentDirectory}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <TextBlock Grid.Column="2" Text="{x:Bind SizeText}" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
          </Grid>
        </Border>
      </DataTemplate>
      <DataTemplate x:Key="TileTemplate" x:DataType="models:ImageEntry">
        <Grid Width="166" Padding="8,6" RowSpacing="6" ContextFlyout="{StaticResource ItemMenu}" RightTapped="Item_RightTapped">
          <Grid.RowDefinitions>
            <RowDefinition Height="105"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Grid>
            <Border BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4"/>
            <FontIcon Glyph="{x:Bind IconGlyph}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="Uniform" Margin="3"/>
          </Grid>
          <StackPanel Grid.Row="1" Spacing="2">
            <TextBlock Text="{x:Bind Name}" FontSize="12" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{x:Bind SizeText}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
          </StackPanel>
        </Grid>
      </DataTemplate>
    </Border.Resources>
    <Grid x:Name="WorkspaceGrid" RowDefinitions="Auto,*,Auto" RowSpacing="16">
      <Grid RowDefinitions="Auto,Auto" RowSpacing="12">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
          <StackPanel Spacing="3">
            <TextBlock Text="PDFを作成" FontSize="26" FontWeight="SemiBold"/>
            <TextBlock Text="画像やPDFを並べて、設定を選んで保存します" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
          </StackPanel>
          <Button x:Name="VersionButton" Padding="10,4" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Click="VersionButton_Click" ToolTipService.ToolTip="バージョン情報とアップデートを確認します" AutomationProperties.Name="バージョン情報とアップデートを確認します" Grid.Column="1">
            <Grid>
              <TextBlock Text="v2.3.3" Foreground="{ThemeResource TextFillColorSecondaryBrush}" x:Name="VersionText"/>
              <Ellipse x:Name="UpdateBadge" Width="9" Height="9" Margin="0,-3,-8,0" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed" Fill="{ThemeResource AccentFillColorDefaultBrush}"/>
            </Grid>
          </Button>
        </Grid>
        <Grid Grid.Row="1" RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="10">
          <TextBlock Text="設定プリセット" VerticalAlignment="Center"/>
          <ComboBox x:Name="PresetBox" PlaceholderText="選ぶと変換設定を適用します" DisplayMemberPath="DisplayName" HorizontalAlignment="Stretch" SelectionChanged="PresetBox_SelectionChanged" Grid.Column="1" Width="240"/>
          <Button x:Name="PresetManageButton" Grid.Column="2" Content="管理" ToolTipService.ToolTip="プリセットの保存・上書き・削除">
            <Button.Flyout>
              <MenuFlyout>
                <MenuFlyoutItem x:Name="SavePresetButton" Text="現在の設定に名前を付けて保存" Click="SavePresetButton_Click"/>
                <MenuFlyoutItem x:Name="OverwritePresetButton" Text="選択したプリセットを上書き" IsEnabled="False" Click="OverwritePresetButton_Click"/>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem x:Name="DeletePresetButton" Text="選択したプリセットを削除" IsEnabled="False" Click="DeletePresetButton_Click"/>
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <TextBlock x:Name="PresetStatusText" Text="画質・用紙・配置などをまとめて切り替えられます。" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Grid.Column="3" VerticalAlignment="Center"/>
        </Grid>
      </Grid>
      <Grid x:Name="PanesGrid" Grid.Row="1" ColumnDefinitions="*,340" ColumnSpacing="18">
        <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="10">
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <TextBlock Text="ファイルと順序" FontSize="17" FontWeight="SemiBold"/>
              <TextBlock x:Name="CountText" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
            <ComboBox x:Name="FolderSortBox" Width="128" SelectedIndex="0" ToolTipService.ToolTip="フォルダー追加・複数ファイル追加時の並び順" Grid.Column="1">
              <ComboBoxItem Content="名前順"/>
              <ComboBoxItem Content="数字順"/>
              <ComboBoxItem Content="更新日時順"/>
            </ComboBox>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
              <ToggleButton x:Name="ListViewButton" Content="リスト" IsChecked="True" Click="ViewModeButton_Click" ToolTipService.ToolTip="ファイル名の一覧で表示します"/>
              <ToggleButton x:Name="GridViewButton" Content="グリッド" Click="ViewModeButton_Click" ToolTipService.ToolTip="サムネイルを並べて表示します"/>
            </StackPanel>
          </Grid>
          <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
            <Button x:Name="AddFilesButton" Content="ファイルを追加" Click="AddFilesButton_Click"/>
            <Button x:Name="AddFolderButton" Content="フォルダーを追加" Click="AddFolderButton_Click" Grid.Column="1"/>
            <TextBox x:Name="SearchBox" PlaceholderText="ファイル名で検索" VerticalAlignment="Center" TextChanged="SearchBox_TextChanged" Grid.Column="2"/>
          </Grid>
          <Grid Grid.Row="2">
            <ListView x:Name="FilesList" SelectionMode="Extended" CanReorderItems="True" CanDragItems="True" AllowDrop="True" ItemsSource="{x:Bind ViewModel.VisibleItems, Mode=OneWay}" ItemsPanel="{StaticResource ListPanel}" ItemTemplate="{StaticResource RowTemplate}" SelectionChanged="FilesList_SelectionChanged" ContainerContentChanging="FilesList_ContainerContentChanging" DragItemsStarting="FilesList_DragItemsStarting" DragItemsCompleted="FilesList_DragItemsCompleted" Background="Transparent" BorderThickness="0">
              <ListView.KeyboardAccelerators>
                <KeyboardAccelerator Key="Delete" Invoked="DeleteAccelerator_Invoked"/>
                <KeyboardAccelerator Key="A" Modifiers="Control" Invoked="SelectAllAccelerator_Invoked"/>
              </ListView.KeyboardAccelerators>
            </ListView>
            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" IsHitTestVisible="False">
              <FontIcon Glyph="" HorizontalAlignment="Center" FontSize="28" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              <TextBlock x:Name="EmptyStateText" Text="画像やPDFを追加するか、ここへドラッグしてください" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
          </Grid>
          <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="6">
            <TextBlock Text="ドラッグで並べ替え / 検索は表示のみ" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Button x:Name="MoveUpButton" Content="上へ" Click="MoveUpButton_Click" Grid.Column="1"/>
            <Button x:Name="MoveDownButton" Content="下へ" Click="MoveDownButton_Click" Grid.Column="2"/>
            <Button x:Name="RemoveButton" Content="一覧から外す" Click="RemoveButton_Click" ToolTipService.ToolTip="選択したファイルを一覧から外します。元ファイルは削除しません（Delete）。" Grid.Column="3"/>
            <Button x:Name="FileOptionsButton" Grid.Column="4" Content="その他">
              <Button.Flyout>
                <MenuFlyout>
                  <MenuFlyoutItem x:Name="MoveTopButton" Text="選択を先頭へ" Click="MoveTopButton_Click"/>
                  <MenuFlyoutItem x:Name="MoveBottomButton" Text="選択を末尾へ" Click="MoveBottomButton_Click"/>
                  <MenuFlyoutSeparator/>
                  <MenuFlyoutItem x:Name="ClearButton" Text="すべて一覧から外す" Click="ClearButton_Click"/>
                </MenuFlyout>
              </Button.Flyout>
            </Button>
          </Grid>
          <Border x:Name="PreviewCard" Grid.Row="4" Padding="14" Height="192" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
            <Grid RowDefinitions="Auto,*" RowSpacing="8">
              <TextBlock Text="選択中のファイル" FontWeight="SemiBold"/>
              <Grid Grid.Row="1" ColumnDefinitions="180,*" ColumnSpacing="16">
                <Grid>
                  <Border BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="4">
                    <Image x:Name="PreviewImage" Stretch="Uniform"/>
                  </Border>
                  <TextBlock x:Name="PreviewHint" Text="画像を選択するとプレビューを表示します" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsHitTestVisible="False"/>
                </Grid>
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                  <TextBlock x:Name="PreviewDetails" FontSize="12" LineHeight="17" TextWrapping="Wrap" IsTextSelectionEnabled="True" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </ScrollViewer>
              </Grid>
            </Grid>
          </Border>
        </Grid>
        <Border Grid.Column="1" Padding="16" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
          <Grid RowDefinitions="Auto,*" RowSpacing="12">
            <TextBlock Text="変換設定" FontSize="18" FontWeight="SemiBold"/>
            <ScrollViewer x:Name="SettingsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
              <StackPanel Spacing="8">
                <Expander x:Name="BasicSettingsExpander" Header="基本設定" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                  <StackPanel Spacing="10">
                    <TextBlock Text="画質" FontWeight="SemiBold"/>
                    <ComboBox x:Name="QualityBox" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="QualityBox_SelectionChanged">
                      <ComboBoxItem Content="元画質優先" Tag="original"/>
                      <ComboBoxItem Content="軽量化" Tag="compact"/>
                    </ComboBox>
                    <Grid x:Name="CompactPanel" ColumnDefinitions="*,Auto" ColumnSpacing="8" Visibility="Collapsed" RowDefinitions="Auto,Auto" RowSpacing="8">
                      <TextBlock Text="最大DPI" VerticalAlignment="Center" Grid.Row="0"/>
                      <NumberBox x:Name="CompactDpiBox" Grid.Column="1" Width="96" Minimum="36" Maximum="600" Value="150" SmallChange="10" SpinButtonPlacementMode="Compact" Grid.Row="0"/>
                      <TextBlock Text="JPEG品質" VerticalAlignment="Center" Grid.Row="1"/>
                      <NumberBox x:Name="JpegQualityBox" Grid.Column="1" Width="96" Minimum="1" Maximum="100" Value="85" SmallChange="5" SpinButtonPlacementMode="Compact" Grid.Row="1"/>
                    </Grid>
                    <TextBlock Text="用紙" FontWeight="SemiBold"/>
                    <ComboBox x:Name="PaperBox" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="PaperBox_SelectionChanged">
                      <ComboBoxItem Content="元のサイズ" Tag=""/>
                      <ComboBoxItem Content="A4" Tag="A4"/>
                      <ComboBoxItem Content="A3" Tag="A3"/>
                      <ComboBoxItem Content="A5" Tag="A5"/>
                      <ComboBoxItem Content="B4" Tag="B4"/>
                      <ComboBoxItem Content="B5" Tag="B5"/>
                      <ComboBoxItem Content="Letter" Tag="Letter"/>
                      <ComboBoxItem Content="Legal" Tag="Legal"/>
                      <ComboBoxItem Content="はがき (100×148mm)" Tag="Postcard"/>
                      <ComboBoxItem Content="L判 (89×127mm)" Tag="L"/>
                      <ComboBoxItem Content="2L判 (127×178mm)" Tag="2L"/>
                      <ComboBoxItem Content="カスタム…" Tag="Custom"/>
                    </ComboBox>
                    <Grid x:Name="CustomPagePanel" ColumnDefinitions="*,Auto" ColumnSpacing="8" Visibility="Collapsed" RowDefinitions="Auto,Auto" RowSpacing="8">
                      <TextBlock Text="幅 (mm)" VerticalAlignment="Center" Grid.Row="0"/>
                      <NumberBox x:Name="CustomWidthBox" Grid.Column="1" Width="96" Minimum="10" Maximum="5000" Value="100" SpinButtonPlacementMode="Compact" Grid.Row="0"/>
                      <TextBlock Text="高さ (mm)" VerticalAlignment="Center" Grid.Row="1"/>
                      <NumberBox x:Name="CustomHeightBox" Grid.Column="1" Width="96" Minimum="10" Maximum="5000" Value="148" SpinButtonPlacementMode="Compact" Grid.Row="1"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                      <StackPanel Spacing="4">
                        <TextBlock Text="余白 (mm)" FontWeight="SemiBold"/>
                        <TextBlock Text="0〜100 mm" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                      </StackPanel>
                      <NumberBox x:Name="MarginBox" Grid.Column="1" Width="120" Minimum="0" Maximum="100" SpinButtonPlacementMode="Compact" Value="0" SmallChange="1" LargeChange="5"/>
                    </Grid>
                  </StackPanel>
                </Expander>
                <Expander x:Name="LayoutSettingsExpander" Header="レイアウト" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                  <StackPanel Spacing="10">
                    <CheckBox x:Name="AutoRotateBox" Content="横長用紙へ自動回転" IsChecked="True"/>
                    <StackPanel x:Name="PagePlacementPanel" Spacing="8" Visibility="Collapsed">
                      <CheckBox x:Name="FitToPageBox">
                        <CheckBox.Content>
                          <TextBlock Text="小さな画像を用紙いっぱいに拡大" TextWrapping="Wrap"/>
                        </CheckBox.Content>
                      </CheckBox>
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <TextBlock Text="配置" VerticalAlignment="Center" FontSize="12"/>
                        <ComboBox x:Name="AlignmentBox" Grid.Column="1" Width="140" SelectedIndex="0">
                          <ComboBoxItem Content="中央" Tag="center"/>
                          <ComboBoxItem Content="上寄せ" Tag="top"/>
                          <ComboBoxItem Content="左上" Tag="top-left"/>
                        </ComboBox>
                      </Grid>
                    </StackPanel>
                    <TextBlock Text="透過部分の背景" FontWeight="SemiBold"/>
                    <ComboBox x:Name="BackgroundBox" SelectedIndex="0" HorizontalAlignment="Stretch">
                      <ComboBoxItem Content="白" Tag="white"/>
                      <ComboBoxItem Content="黒" Tag="black"/>
                      <ComboBoxItem Content="グレー" Tag="gray"/>
                    </ComboBox>
                  </StackPanel>
                </Expander>
                <Expander x:Name="MetadataExpander" Header="PDF情報・しおり" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                  <StackPanel Spacing="8">
                    <CheckBox x:Name="OutlineBox" Content="ファイルごとにしおりを付ける"/>
                    <TextBox x:Name="TitleBox" Header="タイトル" PlaceholderText="空欄なら書きません"/>
                    <TextBox x:Name="AuthorBox" Header="作成者"/>
                    <TextBox x:Name="SubjectBox" Header="件名"/>
                    <TextBox x:Name="KeywordsBox" Header="キーワード" PlaceholderText="カンマ区切り"/>
                  </StackPanel>
                </Expander>
                <Expander x:Name="AdvancedSettingsExpander" Header="詳細設定" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                  <StackPanel Spacing="10">
                    <Grid ColumnSpacing="12" RowDefinitions="Auto,Auto" RowSpacing="8">
                      <StackPanel Spacing="4">
                        <TextBlock Text="DPI不明時の既定値" FontWeight="SemiBold"/>
                        <TextBlock Text="1〜10000 dpi（取得元は画像情報に表示）" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                      </StackPanel>
                      <NumberBox x:Name="DpiBox" Minimum="1" Maximum="10000" SpinButtonPlacementMode="Compact" Value="96" SmallChange="1" LargeChange="24" ValueChanged="DpiBox_ValueChanged" Grid.Row="1" HorizontalAlignment="Stretch"/>
                    </Grid>
                    <TextBlock x:Name="DpiErrorText" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                  </StackPanel>
                </Expander>
                <TextBlock x:Name="PdfInputNoticeText" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Border>
      </Grid>
      <Border x:Name="ExportArea" Grid.Row="2" Padding="16,12" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
          <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
            <TextBlock Text="保存先" VerticalAlignment="Center"/>
            <TextBox x:Name="OutputPathBox" PlaceholderText="出力するPDFのパス" Grid.Column="1"/>
            <Button x:Name="BrowseOutputButton" Grid.Column="2" Content="参照" Click="BrowseOutputButton_Click"/>
            <Button x:Name="ConvertButton" Content="PDFに保存" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" Click="ConvertButton_Click" Grid.Column="3" MinWidth="140"/>
          </Grid>
          <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <TextBlock Text="出力対象：一覧のすべてのファイル" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <CheckBox x:Name="OpenAfterBox" Content="完了後にPDFを開く" Grid.Column="1"/>
          </Grid>
          <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Spacing="4">
              <TextBlock x:Name="StatusText" Text="画像やPDFを追加してください" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              <ProgressBar x:Name="ConversionProgress" Minimum="0" Maximum="100" Value="0" Height="4"/>
            </StackPanel>
            <Button x:Name="CancelButton" Content="キャンセル" IsEnabled="False" Click="CancelButton_Click" Grid.Column="1"/>
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
