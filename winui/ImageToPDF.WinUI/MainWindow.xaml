<Window
    x:Class="ImageToPDF.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:ImageToPDF.WinUI.Models"
    Title="画像PDF変換ツール"
    mc:Ignorable="d">
    <Border
        x:Name="Root"
        Padding="28,22,28,20"
        AllowDrop="True"
        DragOver="Root_DragOver"
        Drop="Root_Drop"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid RowSpacing="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="20">
            <StackPanel Spacing="4">
                <TextBlock
                    Text="画像からPDFを作成"
                    FontSize="28"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <TextBlock
                    Text="画像を並べて、必要な設定を選びます"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <TextBlock
                Grid.Column="1"
                Text="v2.1.0"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
            <Button
                x:Name="AddFilesButton"
                Content="画像を追加"
                Click="AddFilesButton_Click" />
            <Button
                x:Name="AddFolderButton"
                Grid.Column="1"
                Content="フォルダーを追加"
                Click="AddFolderButton_Click" />
            <TextBox
                x:Name="SearchBox"
                Grid.Column="2"
                PlaceholderText="ファイル名で検索"
                VerticalAlignment="Center"
                TextChanged="SearchBox_TextChanged" />
            <ComboBox
                x:Name="FolderSortBox"
                Grid.Column="3"
                Width="150"
                SelectedIndex="0"
                ToolTipService.ToolTip="フォルダー追加時の並び順">
                <ComboBoxItem Content="名前順" />
                <ComboBoxItem Content="数字順" />
                <ComboBoxItem Content="更新日時順" />
            </ComboBox>
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="*,360" ColumnSpacing="20">
            <Grid Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="8">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock
                            Text="変換する画像"
                            FontSize="17"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock
                            x:Name="CountText"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Button
                        x:Name="MoveTopButton"
                        Grid.Column="1"
                        Content="先頭へ"
                        Click="MoveTopButton_Click" />
                    <Button
                        x:Name="MoveUpButton"
                        Grid.Column="2"
                        Content="上へ"
                        Click="MoveUpButton_Click" />
                    <Button
                        x:Name="MoveDownButton"
                        Grid.Column="3"
                        Content="下へ"
                        Click="MoveDownButton_Click" />
                    <Button
                        x:Name="MoveBottomButton"
                        Grid.Column="4"
                        Content="末尾へ"
                        Click="MoveBottomButton_Click" />
                    <Button
                        x:Name="RemoveButton"
                        Grid.Column="5"
                        Content="選択を削除"
                        Click="RemoveButton_Click" />
                </Grid>
                <Grid Grid.Row="1">
                    <ListView
                        x:Name="FilesList"
                        SelectionMode="Multiple"
                        ItemsSource="{x:Bind ViewModel.VisibleItems, Mode=OneWay}"
                        SelectionChanged="FilesList_SelectionChanged"
                        Background="Transparent"
                        BorderThickness="0">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:ImageEntry">
                                <Border Padding="10,8">
                                    <Grid ColumnDefinitions="32,*,Auto" ColumnSpacing="12">
                                        <FontIcon
                                            Glyph="&#xE8B9;"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock
                                                Text="{x:Bind Name}"
                                                FontWeight="SemiBold"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Text="{x:Bind ParentDirectory}"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock
                                            Grid.Column="2"
                                            Text="{x:Bind SizeText}"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel
                        x:Name="EmptyState"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8"
                        IsHitTestVisible="False">
                        <FontIcon
                            Glyph="&#xE8B9;"
                            HorizontalAlignment="Center"
                            FontSize="28"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock
                            x:Name="EmptyStateText"
                            Text="画像を追加するか、ここへドラッグしてください"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Grid>

            <Border
                Grid.Column="1"
                Padding="18"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12">
                        <TextBlock
                            Text="変換設定"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                        <Grid Height="142">
                            <Border
                                BorderThickness="1"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                CornerRadius="4">
                                <Image x:Name="PreviewImage" Stretch="Uniform" />
                            </Border>
                            <TextBlock
                                x:Name="PreviewHint"
                                Text="画像を選択するとプレビューを表示します"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                TextWrapping="Wrap"
                                TextAlignment="Center"
                                Margin="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                IsHitTestVisible="False" />
                        </Grid>

                        <TextBlock Text="画質" FontWeight="SemiBold" />
                        <ComboBox x:Name="QualityBox" SelectedIndex="0" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="元画質優先" Tag="original" />
                            <ComboBoxItem Content="軽量化" Tag="compact" />
                        </ComboBox>

                        <TextBlock Text="用紙" FontWeight="SemiBold" />
                        <ComboBox x:Name="PaperBox" SelectedIndex="0" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="元のサイズ" Tag="" />
                            <ComboBoxItem Content="A4" Tag="A4" />
                            <ComboBoxItem Content="A3" Tag="A3" />
                            <ComboBoxItem Content="Letter" Tag="Letter" />
                        </ComboBox>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="余白 (mm)" FontWeight="SemiBold" />
                                <TextBlock
                                    Text="0〜100 mm"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <NumberBox
                                x:Name="MarginBox"
                                Grid.Column="1"
                                Width="120"
                                Minimum="0"
                                Maximum="100"
                                SpinButtonPlacementMode="Compact"
                                Value="0"
                                SmallChange="1"
                                LargeChange="5" />
                        </Grid>

                        <TextBlock Text="透過部分の背景" FontWeight="SemiBold" />
                        <ComboBox x:Name="BackgroundBox" SelectedIndex="0" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="白" Tag="white" />
                            <ComboBoxItem Content="黒" Tag="black" />
                            <ComboBoxItem Content="グレー" Tag="gray" />
                        </ComboBox>

                        <CheckBox x:Name="AutoRotateBox" Content="横長用紙へ自動回転" IsChecked="True" />
                        <CheckBox x:Name="OpenAfterBox" Content="完了後にPDFを開く" />

                        <TextBlock Text="保存先" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox
                                x:Name="OutputPathBox"
                                PlaceholderText="出力するPDFのパス" />
                            <Button
                                Grid.Column="1"
                                Content="参照"
                                Click="BrowseOutputButton_Click" />
                        </Grid>

                        <Button
                            x:Name="ConvertButton"
                            Content="PDFに変換"
                            HorizontalAlignment="Stretch"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="ConvertButton_Click" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Spacing="6">
                <TextBlock
                    x:Name="StatusText"
                    Text="画像を追加してください"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <ProgressBar
                    x:Name="ConversionProgress"
                    Minimum="0"
                    Maximum="100"
                    Value="0"
                    Height="4" />
            </StackPanel>
            <Button
                x:Name="CancelButton"
                Grid.Column="1"
                Content="キャンセル"
                IsEnabled="False"
                Click="CancelButton_Click" />
        </Grid>
        </Grid>
    </Border>
</Window>
