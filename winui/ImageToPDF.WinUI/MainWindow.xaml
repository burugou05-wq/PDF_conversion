<?xml version='1.0' encoding='utf-8'?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:models="using:ImageToPDF.WinUI.Models" x:Class="ImageToPDF.WinUI.MainWindow" Title="画像PDF変換ツール" mc:Ignorable="d">
  <Window.SystemBackdrop>
    <MicaBackdrop/>
  </Window.SystemBackdrop>
  <Border x:Name="Root" Padding="20,14,20,16" AllowDrop="True" DragOver="Root_DragOver" Drop="Root_Drop" Background="Transparent" SizeChanged="Root_SizeChanged">
    <Border.Resources>
      <!-- リスト表示とグリッド表示は、同じListViewの ItemsPanel と ItemTemplate を差し替えます。 -->
      <ItemsPanelTemplate x:Key="ListPanel">
        <ItemsStackPanel Orientation="Vertical"/>
      </ItemsPanelTemplate>
      <ItemsPanelTemplate x:Key="GridPanel">
        <ItemsWrapGrid Orientation="Horizontal"/>
      </ItemsPanelTemplate>
      <!-- 行とタイルで共通の右クリックメニュー。Tag に ImageEntry が入ります。 -->
      <MenuFlyout x:Key="ItemMenu">
        <MenuFlyoutItem Text="エクスプローラーで表示" Click="ShowInExplorer_Click">
          <MenuFlyoutItem.Icon>
            <FontIcon Glyph="&#xE8DA;"/>
          </MenuFlyoutItem.Icon>
        </MenuFlyoutItem>
        <MenuFlyoutItem Text="パスをコピー" Click="CopyPath_Click">
          <MenuFlyoutItem.Icon>
            <FontIcon Glyph="&#xE8C8;"/>
          </MenuFlyoutItem.Icon>
        </MenuFlyoutItem>
        <MenuFlyoutItem Text="サムネイルを再読み込み" Click="ReloadThumbnail_Click">
          <MenuFlyoutItem.Icon>
            <FontIcon Glyph="&#xE72C;"/>
          </MenuFlyoutItem.Icon>
        </MenuFlyoutItem>
        <MenuFlyoutSeparator/>
        <MenuFlyoutItem Text="これより上を削除" Click="RemoveAbove_Click"/>
        <MenuFlyoutItem Text="これより下を削除" Click="RemoveBelow_Click"/>
        <MenuFlyoutItem Text="選択を削除" Click="RemoveButton_Click">
          <MenuFlyoutItem.Icon>
            <FontIcon Glyph="&#xE74D;"/>
          </MenuFlyoutItem.Icon>
        </MenuFlyoutItem>
      </MenuFlyout>
      <DataTemplate x:Key="RowTemplate" x:DataType="models:ImageEntry">
        <Border Padding="8,7" ContextFlyout="{StaticResource ItemMenu}" RightTapped="Item_RightTapped">
          <Grid ColumnDefinitions="Auto,28,*,Auto,Auto" ColumnSpacing="10">
            <FontIcon Glyph="&#xE784;" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
            <FontIcon Grid.Column="1" Glyph="{x:Bind IconGlyph}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
              <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="{x:Bind ParentDirectory}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <Border Grid.Column="3" Visibility="{x:Bind PdfBadgeVisibility}" Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
              <TextBlock Text="PDF" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
            </Border>
            <TextBlock Grid.Column="4" Text="{x:Bind SizeText}" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
          </Grid>
        </Border>
      </DataTemplate>
      <DataTemplate x:Key="TileTemplate" x:DataType="models:ImageEntry">
        <Grid Width="166" Padding="8,6" RowSpacing="6" ContextFlyout="{StaticResource ItemMenu}" RightTapped="Item_RightTapped">
          <Grid.RowDefinitions>
            <RowDefinition Height="105"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Grid>
            <Border BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6"/>
            <FontIcon Glyph="{x:Bind IconGlyph}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="Uniform" Margin="3"/>
            <Border Visibility="{x:Bind PdfBadgeVisibility}" Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}" CornerRadius="4" Padding="5,1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6">
              <TextBlock Text="PDF" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
            </Border>
          </Grid>
          <StackPanel Grid.Row="1" Spacing="2">
            <TextBlock Text="{x:Bind Name}" FontSize="12" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{x:Bind SizeText}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
          </StackPanel>
        </Grid>
      </DataTemplate>
    </Border.Resources>
    <Grid x:Name="WorkspaceGrid" RowDefinitions="Auto,*,Auto" RowSpacing="12">
      <!-- トップバー: タイトル + プリセット + バージョン -->
      <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,Auto,Auto,Auto,*" ColumnSpacing="10">
        <TextBlock Text="PDFを作成" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <TextBlock Grid.Column="1" Text="プリセット" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        <ComboBox x:Name="PresetBox" Grid.Column="2" PlaceholderText="設定プリセットを選択" DisplayMemberPath="DisplayName" Width="210" SelectionChanged="PresetBox_SelectionChanged"/>
        <Button x:Name="PresetManageButton" Grid.Column="3" Content="管理" ToolTipService.ToolTip="プリセットの保存・上書き・削除">
          <Button.Flyout>
            <MenuFlyout>
              <MenuFlyoutItem x:Name="SavePresetButton" Text="現在の設定に名前を付けて保存" Click="SavePresetButton_Click"/>
              <MenuFlyoutItem x:Name="OverwritePresetButton" Text="選択したプリセットを上書き" IsEnabled="False" Click="OverwritePresetButton_Click"/>
              <MenuFlyoutSeparator/>
              <MenuFlyoutItem x:Name="DeletePresetButton" Text="選択したプリセットを削除" IsEnabled="False" Click="DeletePresetButton_Click"/>
            </MenuFlyout>
          </Button.Flyout>
        </Button>
        <TextBlock x:Name="PresetStatusText" Text="画質・用紙・配置などをまとめて切り替えられます。" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Grid.Column="4" VerticalAlignment="Center" Margin="6,0,90,0"/>
        <Button x:Name="VersionButton" Grid.Column="4" HorizontalAlignment="Right" Padding="10,4" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Click="VersionButton_Click" ToolTipService.ToolTip="バージョン情報とアップデートを確認します" AutomationProperties.Name="バージョン情報とアップデートを確認します">
          <Grid>
            <TextBlock Text="v2.3.3.2" Foreground="{ThemeResource TextFillColorSecondaryBrush}" x:Name="VersionText"/>
            <Ellipse x:Name="UpdateBadge" Width="9" Height="9" Margin="0,-3,-8,0" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed" Fill="{ThemeResource AccentFillColorDefaultBrush}"/>
          </Grid>
        </Button>
      </Grid>

      <!-- メイン2ペイン: 左=フルハイト一覧、右=タブ切替インスペクター -->
      <Grid x:Name="PanesGrid" Grid.Row="1" ColumnDefinitions="*,350" ColumnSpacing="14">
        <Border Padding="14,12" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8">
          <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
            <!-- 一覧ツールバー -->
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
              <Button x:Name="AddFilesButton" Style="{StaticResource AccentButtonStyle}" Click="AddFilesButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <FontIcon Glyph="&#xE710;" FontSize="13"/>
                  <TextBlock Text="ファイル"/>
                </StackPanel>
              </Button>
              <Button x:Name="AddFolderButton" Grid.Column="1" Click="AddFolderButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <FontIcon Glyph="&#xE8B7;" FontSize="13"/>
                  <TextBlock Text="フォルダー"/>
                </StackPanel>
              </Button>
              <TextBox x:Name="SearchBox" Grid.Column="2" PlaceholderText="ファイル名で検索" VerticalAlignment="Center" TextChanged="SearchBox_TextChanged"/>
              <ComboBox x:Name="FolderSortBox" Grid.Column="3" Width="116" SelectedIndex="0" ToolTipService.ToolTip="フォルダー追加・複数ファイル追加時の並び順">
                <ComboBoxItem Content="名前順"/>
                <ComboBoxItem Content="数字順"/>
                <ComboBoxItem Content="更新日時順"/>
              </ComboBox>
              <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="2">
                <ToggleButton x:Name="ListViewButton" IsChecked="True" Click="ViewModeButton_Click" ToolTipService.ToolTip="ファイル名の一覧で表示します" AutomationProperties.Name="リスト表示">
                  <FontIcon Glyph="&#xE8FD;" FontSize="14"/>
                </ToggleButton>
                <ToggleButton x:Name="GridViewButton" Click="ViewModeButton_Click" ToolTipService.ToolTip="サムネイルを並べて表示します" AutomationProperties.Name="グリッド表示">
                  <FontIcon Glyph="&#xF0E2;" FontSize="14"/>
                </ToggleButton>
              </StackPanel>
              <Border Grid.Column="5" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="10" Padding="10,4" VerticalAlignment="Center">
                <TextBlock x:Name="CountText" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              </Border>
            </Grid>

            <!-- フルハイトのファイル一覧 -->
            <Grid Grid.Row="1">
              <ListView x:Name="FilesList" SelectionMode="Extended" CanReorderItems="True" CanDragItems="True" AllowDrop="True" ItemsSource="{x:Bind ViewModel.VisibleItems, Mode=OneWay}" ItemsPanel="{StaticResource ListPanel}" ItemTemplate="{StaticResource RowTemplate}" SelectionChanged="FilesList_SelectionChanged" ContainerContentChanging="FilesList_ContainerContentChanging" DragItemsStarting="FilesList_DragItemsStarting" DragItemsCompleted="FilesList_DragItemsCompleted" Background="Transparent" BorderThickness="0">
                <ListView.KeyboardAccelerators>
                  <KeyboardAccelerator Key="Delete" Invoked="DeleteAccelerator_Invoked"/>
                  <KeyboardAccelerator Key="A" Modifiers="Control" Invoked="SelectAllAccelerator_Invoked"/>
                </ListView.KeyboardAccelerators>
              </ListView>
              <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" IsHitTestVisible="False">
                <FontIcon Glyph="&#xE8B9;" HorizontalAlignment="Center" FontSize="32" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock x:Name="EmptyStateText" Text="画像やPDFを追加するか、ここへドラッグしてください" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              </StackPanel>
            </Grid>

            <!-- 一覧操作フッター -->
            <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="6">
              <TextBlock Text="ドラッグで並べ替え / Deleteで削除 / Ctrl+Aで全選択" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              <Button x:Name="MoveUpButton" Grid.Column="1" Click="MoveUpButton_Click" ToolTipService.ToolTip="選択を1つ上へ" AutomationProperties.Name="上へ">
                <FontIcon Glyph="&#xE74A;" FontSize="13"/>
              </Button>
              <Button x:Name="MoveDownButton" Grid.Column="2" Click="MoveDownButton_Click" ToolTipService.ToolTip="選択を1つ下へ" AutomationProperties.Name="下へ">
                <FontIcon Glyph="&#xE74B;" FontSize="13"/>
              </Button>
              <Button x:Name="RemoveButton" Content="一覧から外す" Click="RemoveButton_Click" ToolTipService.ToolTip="選択したファイルを一覧から外します。元ファイルは削除しません（Delete）。" Grid.Column="3"/>
              <Button x:Name="FileOptionsButton" Grid.Column="4" Content="その他">
                <Button.Flyout>
                  <MenuFlyout>
                    <MenuFlyoutItem x:Name="MoveTopButton" Text="選択を先頭へ" Click="MoveTopButton_Click"/>
                    <MenuFlyoutItem x:Name="MoveBottomButton" Text="選択を末尾へ" Click="MoveBottomButton_Click"/>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem x:Name="ClearButton" Text="すべて一覧から外す" Click="ClearButton_Click"/>
                  </MenuFlyout>
                </Button.Flyout>
              </Button>
            </Grid>
          </Grid>
        </Border>

        <!-- 右ペイン: タブ切替インスペクター -->
        <Border Grid.Column="1" Padding="14,12" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
          <Grid RowDefinitions="Auto,*" RowSpacing="12">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
              <ToggleButton x:Name="SettingsTabButton" Content="変換設定" IsChecked="True" HorizontalAlignment="Stretch" Click="InspectorTabButton_Click"/>
              <ToggleButton x:Name="PreviewTabButton" Grid.Column="1" Content="プレビュー &amp; 情報" IsChecked="False" HorizontalAlignment="Stretch" Click="InspectorTabButton_Click"/>
            </Grid>

            <!-- タブ1: 変換設定 -->
            <ScrollViewer x:Name="SettingsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
              <StackPanel Spacing="8">
                <Expander x:Name="BasicSettingsExpander" Header="基本設定" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                  <StackPanel Spacing="10">
                    <TextBlock Text="画質" FontWeight="SemiBold"/>
                    <ComboBox x:Name="QualityBox" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="QualityBox_SelectionChanged">
                      <ComboBoxItem Content="元画質優先" Tag="original"/>
                      <ComboBoxItem Content="軽量化" Tag="compact"/>
                    </ComboBox>
                    <Grid x:Name="CompactPanel" ColumnDefinitions="*,Auto" ColumnSpacing="8" Visibility="Collapsed" RowDefinitions="Auto,Auto" RowSpacing="8">
                      <TextBlock Text="最大DPI" VerticalAlignment="Center" Grid.Row="0"/>
                      <NumberBox x:Name="CompactDpiBox" Grid.Column="1" Width="96" Minimum="36" Maximum="600" Value="150" SmallChange="10" SpinButtonPlacementMode="Compact" Grid.Row="0"/>
                      <TextBlock Text="JPEG品質" VerticalAlignment="Center" Grid.Row="1"/>
                      <NumberBox x:Name="JpegQualityBox" Grid.Column="1" Width="96" Minimum="1" Maximum="100" Value="85" SmallChange="5" SpinButtonPlacementMode="Compact" Grid.Row="1"/>
                    </Grid>
                    <TextBlock Text="用紙" FontWeight="SemiBold"/>
                    <ComboBox x:Name="PaperBox" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="PaperBox_SelectionChanged">
                      <ComboBoxItem Content="元のサイズ" Tag=""/>
                      <ComboBoxItem Content="A4" Tag="A4"/>
                      <ComboBoxItem Content="A3" Tag="A3"/>
                      <ComboBoxItem Content="A5" Tag="A5"/>
                      <ComboBoxItem Content="B4" Tag="B4"/>
                      <ComboBoxItem Content="B5" Tag="B5"/>
                      <ComboBoxItem Content="Letter" Tag="Letter"/>
                      <ComboBoxItem Content="Legal" Tag="Legal"/>
                      <ComboBoxItem Content="はがき (100×148mm)" Tag="Postcard"/>
                      <ComboBoxItem Content="L判 (89×127mm)" Tag="L"/>
                      <ComboBoxItem Content="2L判 (127×178mm)" Tag="2L"/>
                      <ComboBoxItem Content="カスタム…" Tag="Custom"/>
                    </ComboBox>
                    <Grid x:Name="CustomPagePanel" ColumnDefinitions="*,Auto" ColumnSpacing="8" Visibility="Collapsed" RowDefinitions="Auto,Auto" RowSpacing="8">
                      <TextBlock Text="幅 (mm)" VerticalAlignment="Center" Grid.Row="0"/>
                      <NumberBox x:Name="CustomWidthBox" Grid.Column="1" Width="96" Minimum="10" Maximum="5000" Value="100" SpinButtonPlacementMode="Compact" Grid.Row="0"/>
                      <TextBlock Text="高さ (mm)" VerticalAlignment="Center" Grid.Row="1"/>
                      <NumberBox x:Name="CustomHeightBox" Grid.Column="1" Width="96" Minimum="10" Maximum="5000" Value="148" SpinButtonPlacementMode="Compact" Grid.Row="1"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                      <StackPanel Spacing="4">
                        <TextBlock Text="余白 (mm)" FontWeight="SemiBold"/>
                        <TextBlock Text="0〜100 mm" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                      </StackPanel>
                      <NumberBox x:Name="MarginBox" Grid.Column="1" Width="120" Minimum="0" Maximum="100" SpinButtonPlacementMode="Compact" Value="0" SmallChange="1" LargeChange="5"/>
                    </Grid>
                  </StackPanel>
                </Expander>
                <Expander x:Name="LayoutSettingsExpander" Header="レイアウト" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                  <StackPanel Spacing="10">
                    <CheckBox x:Name="AutoRotateBox" Content="横長用紙へ自動回転" IsChecked="True"/>
                    <StackPanel x:Name="PagePlacementPanel" Spacing="8" Visibility="Collapsed">
                      <CheckBox x:Name="FitToPageBox">
                        <CheckBox.Content>
                          <TextBlock Text="小さな画像を用紙いっぱいに拡大" TextWrapping="Wrap"/>
                        </CheckBox.Content>
                      </CheckBox>
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <TextBlock Text="配置" VerticalAlignment="Center" FontSize="12"/>
                        <ComboBox x:Name="AlignmentBox" Grid.Column="1" Width="140" SelectedIndex="0">
                          <ComboBoxItem Content="中央" Tag="center"/>
                          <ComboBoxItem Content="上寄せ" Tag="top"/>
                          <ComboBoxItem Content="左上" Tag="top-left"/>
                        </ComboBox>
                      </Grid>
                    </StackPanel>
                    <TextBlock Text="透過部分の背景" FontWeight="SemiBold"/>
                    <ComboBox x:Name="BackgroundBox" SelectedIndex="0" HorizontalAlignment="Stretch">
                      <ComboBoxItem Content="白" Tag="white"/>
                      <ComboBoxItem Content="黒" Tag="black"/>
                      <ComboBoxItem Content="グレー" Tag="gray"/>
                    </ComboBox>
                  </StackPanel>
                </Expander>
                <Expander x:Name="MetadataExpander" Header="PDF情報・しおり" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                  <StackPanel Spacing="8">
                    <CheckBox x:Name="OutlineBox" Content="ファイルごとにしおりを付ける"/>
                    <TextBox x:Name="TitleBox" Header="タイトル" PlaceholderText="空欄なら書きません"/>
                    <TextBox x:Name="AuthorBox" Header="作成者"/>
                    <TextBox x:Name="SubjectBox" Header="件名"/>
                    <TextBox x:Name="KeywordsBox" Header="キーワード" PlaceholderText="カンマ区切り"/>
                  </StackPanel>
                </Expander>
                <Expander x:Name="AdvancedSettingsExpander" Header="詳細設定" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                  <StackPanel Spacing="10">
                    <Grid ColumnSpacing="12" RowDefinitions="Auto,Auto" RowSpacing="8">
                      <StackPanel Spacing="4">
                        <TextBlock Text="DPI不明時の既定値" FontWeight="SemiBold"/>
                        <TextBlock Text="1〜10000 dpi（取得元は画像情報に表示）" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                      </StackPanel>
                      <NumberBox x:Name="DpiBox" Minimum="1" Maximum="10000" SpinButtonPlacementMode="Compact" Value="96" SmallChange="1" LargeChange="24" ValueChanged="DpiBox_ValueChanged" Grid.Row="1" HorizontalAlignment="Stretch"/>
                    </Grid>
                    <TextBlock x:Name="DpiErrorText" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                  </StackPanel>
                </Expander>
                <TextBlock x:Name="PdfInputNoticeText" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              </StackPanel>
            </ScrollViewer>

            <!-- タブ2: プレビュー & 情報 -->
            <Grid x:Name="PreviewPanel" Grid.Row="1" RowDefinitions="*,Auto" RowSpacing="12" Visibility="Collapsed">
              <Grid MinHeight="220">
                <Border BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="6">
                  <Image x:Name="PreviewImage" Stretch="Uniform" Margin="8"/>
                </Border>
                <TextBlock x:Name="PreviewHint" Text="画像を選択するとプレビューを表示します" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsHitTestVisible="False"/>
              </Grid>
              <Border Grid.Row="1" Padding="12" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="6" MaxHeight="200">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <TextBlock x:Name="PreviewDetails" FontSize="12" LineHeight="18" TextWrapping="Wrap" IsTextSelectionEnabled="True" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </ScrollViewer>
              </Border>
            </Grid>
          </Grid>
        </Border>
      </Grid>

      <!-- スリムな下部保存バー -->
      <Border x:Name="ExportArea" Grid.Row="2" Padding="14,10" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
          <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
            <TextBlock Text="保存先" VerticalAlignment="Center"/>
            <TextBox x:Name="OutputPathBox" PlaceholderText="出力するPDFのパス" Grid.Column="1"/>
            <Button x:Name="BrowseOutputButton" Grid.Column="2" Content="参照" Click="BrowseOutputButton_Click"/>
            <Button x:Name="ConvertButton" Content="PDFに保存" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" Click="ConvertButton_Click" Grid.Column="3" MinWidth="136"/>
          </Grid>
          <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <TextBlock x:Name="StatusText" Text="画像やPDFを追加してください" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <CheckBox x:Name="OpenAfterBox" Content="完了後にPDFを開く" Grid.Column="1"/>
          </Grid>
          <Grid x:Name="ProgressRow" Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="12" Visibility="Collapsed">
            <ProgressBar x:Name="ConversionProgress" Minimum="0" Maximum="100" Value="0" Height="4" VerticalAlignment="Center"/>
            <Button x:Name="CancelButton" Content="キャンセル" IsEnabled="False" Click="CancelButton_Click" Grid.Column="1"/>
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
