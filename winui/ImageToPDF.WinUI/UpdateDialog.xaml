<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="ImageToPDF.WinUI.UpdateDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="アップデート"
    CloseButtonText="閉じる"
    DefaultButton="Primary"
    PrimaryButtonClick="PrimaryButton_Click">

    <!-- 幅を固定し、内容が増えてもダイアログが画面いっぱいに広がらないようにします。 -->
    <StackPanel MinWidth="420" MaxWidth="560" Spacing="14">

        <StackPanel Spacing="2">
            <TextBlock
                x:Name="CurrentVersionText"
                FontWeight="SemiBold"
                Text="現在のバージョン" />
            <TextBlock
                x:Name="StatusText"
                FontSize="12"
                TextWrapping="Wrap"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock
                x:Name="VersionSummaryText"
                FontSize="16"
                FontWeight="SemiBold"
                TextWrapping="Wrap"
                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            <TextBlock
                x:Name="ReleaseInfoText"
                FontSize="12"
                TextWrapping="Wrap"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <ProgressBar
            x:Name="DownloadProgress"
            Height="4"
            Visibility="Collapsed"
            Minimum="0"
            Maximum="100"
            Value="0" />

        <Expander
            x:Name="NotesExpander"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            IsExpanded="True"
            Header="更新内容">
            <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                <RichTextBlock
                    x:Name="NotesText"
                    FontSize="13"
                    TextWrapping="Wrap" />
            </ScrollViewer>
        </Expander>

        <Button
            x:Name="OpenReleasesButton"
            Content="リリースページを開く"
            Visibility="Collapsed"
            Click="OpenReleasesButton_Click" />
    </StackPanel>
</ContentDialog>
